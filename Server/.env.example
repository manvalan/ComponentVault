# ComponentVault API — copia in .env sul VPS (NON committare)

POSTGRES_DB=componentvault
POSTGRES_USER=cvault
POSTGRES_PASSWORD=CAMBIA_PASSWORD_LUNGA

API_PORT=8100
API_KEY=CAMBIA_API_KEY_LUNGA
# Chiave del worker KiCad sul Mac (scripts/fetch_worker.py): diversa da API_KEY,
# non va mai messa nelle app. Vuota = coda KiCad disattivata.
WORKER_API_KEY=
DATABASE_URL=postgresql+psycopg://cvault:CAMBIA_PASSWORD_LUNGA@db:5432/componentvault

CORS_ORIGINS=https://michelebigi.it
